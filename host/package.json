{
  "name": "@lightwebinc/borg-host",
  "version": "0.7.2",
  "private": true,
  "description": "The borg record layer in TypeScript and the host module for an overlay host: organisation, group, grant and wrap records, hall names, scopes, lookup questions, the epoch key and its wraps, the topic manager's transaction rules and the index's chain rules, held to the Go codec's vectors, and tm_borg with ls_borg as a module the host loads by path",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./codec/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist/admit.js",
    "dist/admit.d.ts",
    "dist/beef.js",
    "dist/beef.d.ts",
    "dist/borgrec.js",
    "dist/borgrec.d.ts",
    "dist/chain.js",
    "dist/chain.d.ts",
    "dist/epoch.js",
    "dist/epoch.d.ts",
    "dist/merkle.js",
    "dist/merkle.d.ts",
    "dist/permission.js",
    "dist/permission.d.ts",
    "dist/refusal.js",
    "dist/refusal.d.ts",
    "dist/query.js",
    "dist/query.d.ts",
    "dist/scope.js",
    "dist/scope.d.ts",
    "dist/script.js",
    "dist/script.d.ts",
    "dist/util.js",
    "dist/util.d.ts",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "bundle": "node scripts/bundle.js",
    "check": "tsc --noEmit",
    "pretest": "npm run build && npm run bundle",
    "test": "node --test \"dist/**/*.test.js\"",
    "vectors": "node dist/tsvectors.js",
    "vectors-check": "node dist/tsvectors.js -check",
    "prepack": "npm run build -- --sourceMap false && node -e \"for (const f of ['LICENSE', 'NOTICE']) require('node:fs').copyFileSync('../' + f, f)\""
  },
  "dependencies": {
    "@bsv/sdk": "2.7.1"
  },
  "devDependencies": {
    "@bsv/overlay": "2.3.1",
    "@lightwebinc/bcommon": "file:vendor/lightwebinc-bcommon-0.32.1.tgz",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@lightwebinc/bcommon": "^0.32.1"
  }
}
